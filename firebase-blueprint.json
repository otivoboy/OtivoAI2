{
  "entities": {
    "users": {
      "title": "Users",
      "description": "User account details and settings",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "displayName": { "type": "string" },
        "photoURL": { "type": "string" },
        "createdAt": { "type": "string" },
        "lastLoginMethod": { "type": "string" }
      },
      "required": ["uid", "email"]
    },
    "userSessions": {
      "title": "User Sessions",
      "description": "Chat sessions and history for each user",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "title": { "type": "string" },
        "createdAt": { "type": "number" },
        "messages": { "type": "array" }
      },
      "required": ["id", "userId"]
    }
  }
}
